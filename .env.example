# 牧融绿链 - MySQL 数据库配置
# 复制此文件为 .env 并填写实际值
# 如果不配置 MySQL，系统自动使用 JSON Store / 样例数据

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=yak_green_chain

# 高德天气 Web 服务 Key
# 申请地址：https://lbs.amap.com/api/webservice/guide/api/weatherinfo
# 用途：后端调用天气查询，不暴露给浏览器；可选增强。
AMAP_WEB_SERVICE_KEY=

# 高德地图 JS API 2.0
# 申请地址：https://lbs.amap.com/api/javascript-api-v2/guide/abc/load
# 用途：前端地图展示；需要在高德控制台配置安全密钥。
AMAP_JS_API_KEY=
AMAP_SECURITY_JS_CODE=

# Open-Meteo 开放天气
# 官方文档：https://open-meteo.com/en/docs
# 无需 API Key，系统默认用于按经纬度获取实时天气。
OPEN_METEO_ENDPOINT=https://api.open-meteo.com/v1/forecast

# 演示助手（Demo Guide）· LLM 配置
# 演示助手用 LLM API 做知识问答与授信测算结果转述；不配置则问答降级为知识库选段直出。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ai.codesonline.dev
OPENAI_CHAT_MODEL=gpt-5.6-luna

# 演示助手开关：true 启用，false 停用
DEMO_GUIDE_ENABLED=true

# 管理端登录凭据（/admin 与所有管理写接口的会话鉴权）
# 真实用户名和密码只写在本地 .env（已被 .gitignore 忽略），不要提交示例密码。
ADMIN_USERNAME=
ADMIN_PASSWORD=
