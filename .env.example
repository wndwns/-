# 牧融绿链 - MySQL 数据库配置
# 复制此文件为 .env 并填写实际值
# 如果不配置 MySQL，系统自动使用内存样例数据

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=yak_green_chain

# 第三方 API（可选）
# 高德 Web 服务 Key：用于后端调用天气查询，不暴露给浏览器
AMAP_WEB_SERVICE_KEY=

# 高德 JS API Key：用于前端地图展示；需要在高德控制台配置安全密钥
AMAP_JS_API_KEY=
AMAP_SECURITY_JS_CODE=

# 和风天气 Key：作为更多气象要素的扩展源
QWEATHER_API_KEY=
